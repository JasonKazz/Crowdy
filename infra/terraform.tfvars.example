# Copy to terraform.tfvars (ignored by Git) and use the owning tenant.
subscription_id = "146aa8b7-dd72-4385-a658-2e1e39da630c"
tenant_id       = "00000000-0000-0000-0000-000000000000"
location        = "westus2"

# Resource group Owners receive alerts. Additional emails are optional.
monthly_budget_usd    = 40
budget_start_date     = "2026-10-01T00:00:00Z"
budget_contact_emails = []

# Pass the shared Gateway key using TF_VAR_ai_gateway_api_key, or native keys
# using TF_VAR_gemini_api_key and TF_VAR_anthropic_api_key in the shell.
# Do not add credentials here. Omitted exports retain previously saved values.
# scripts/deploy.sh maintains deployment.auto.tfvars.json with the app image.

# Optional independent YOLO crowd-estimation service. The deployment script
# enables it and records its image in crowd-estimation.auto.tfvars.json.
# Keep 0 to scale to zero; set 1 for a warm demo (additional compute cost).
crowd_estimation_min_replicas = 0
crowd_estimation_max_replicas = 2
