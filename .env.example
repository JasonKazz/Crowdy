# Backend settings. The API and local editor load the repository root .env;
# existing process variables take precedence. Keep real values out of Git.
# Next.js uses frontend/.env.local or its Vercel environment separately.
PORT=8000
# Optional locally; use a shared secret on a publicly reachable backend.
# Set the identical value on the Next.js server. Never use NEXT_PUBLIC_.
CROWDY_BACKEND_TOKEN=

# Local filesystem artifact root, relative to the backend working directory.
# Vercel defaults to /tmp/crowdy when unset; that path is not durable storage.
CROWDY_STORAGE_DIR=./data
# Optional locally. Production uses a linked private Vercel Blob store for
# source images and extraction/calibration records. Backend only.
BLOB_READ_WRITE_TOKEN=

# Image extraction providers. One key enables that provider; comparison needs both.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY is also accepted when ANTHROPIC_API_KEY is absent.
# Set model IDs available to your account before production extraction.
# Blank values use the service defaults. Vercel env changes require redeployment.
GEMINI_MODEL=
ANTHROPIC_MODEL=
