# Backend container/hosting settings. Python reads its process environment;
# use your host's environment settings or Docker --env-file .env.
PORT=8000
# Optional shared bearer token; set the same value on the Next.js server.
# Generate a secret for a publicly reachable backend. Never commit it.
CROWDY_BACKEND_TOKEN=

# Copy to the repository root .env. Providers are loaded by the API and local editor.
# Other CROWDY_* settings below remain proposed backend configuration.
# Relative data paths assume the backend is started from the backend/ directory.
CROWDY_ENV=development
CROWDY_HOST=127.0.0.1
CROWDY_PORT=8000
CROWDY_FRONTEND_ORIGIN=http://localhost:3000
CROWDY_DATABASE_URL=sqlite:///./data/crowdy.db
CROWDY_STORAGE_DIR=./data

# Image extraction providers. Keep actual values in your ignored .env.
# Never commit real credentials.

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY is also accepted when ANTHROPIC_API_KEY is absent.
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
