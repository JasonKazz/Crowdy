# Auth0 Regular Web Application. Keep real credentials in .env.local.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=dev-zag8fvtpirhmkbag.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
# Generate a separate 64-character hex value with: openssl rand -hex 32
AUTH0_SECRET=your-generated-session-secret

# Backend for simulation and durable workspaces; development defaults to localhost.
# Production requires the hosted backend's base URL. Do not use NEXT_PUBLIC_.
CROWDY_BACKEND_URL=http://127.0.0.1:8000
# Required for cloud workspaces; match the protected Python service.
CROWDY_BACKEND_TOKEN=
