# Use the identical server-only token in frontend/.env.local.
CROWDY_CROWD_ESTIMATION_TOKEN=replace-with-a-long-random-secret
CROWDY_YOLO_MODEL=models/yolo26n.pt
CROWDY_YOLO_DEVICE=cpu
CROWDY_YOLO_THREADS=2
CROWDY_YOLO_CONFIDENCE=0.25
CROWDY_YOLO_IOU=0.45
CROWDY_YOLO_IMAGE_SIZE=1280
CROWDY_YOLO_MAX_DETECTIONS=10000
CROWDY_COUNT_METHOD=density
CROWDY_DENSITY_MODEL=models/zip-n-nwpu.pth
CROWDY_DENSITY_MIN_SIZE=896
CROWDY_DENSITY_MAX_SIZE=4096
CROWDY_YOLO_TILE_SIZE=640
CROWDY_YOLO_TILE_OVERLAP=0.2
CROWDY_YOLO_MAX_TILES=128
CROWDY_YOLO_INFERENCE_SECONDS=25
